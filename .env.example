# Copy to .env and fill in values
VENUS_HOST=192.168.21.10
# MQTT: 8883 with TLS, or 9001 for plain websockets, 1883 for plain TCP.
# Port 80 /websocket-mqtt is NOT served by current Venus firmware.
VENUS_PORT=8883
PORTAL_ID=c0619ab43e45
POSTGRES_PASSWORD=changeme
# tcp = raw MQTT (8883), websockets = MQTT over websocket (9001)
MQTT_TRANSPORT=tcp
MQTT_TLS=true
# The GX serves a self-signed certificate. Set true to skip peer verification
# while keeping traffic encrypted. Only safe on a trusted LAN.
MQTT_TLS_INSECURE=true
# Optional broker authentication. These are MQTT credentials, not the GX web session.
MQTT_USERNAME=
MQTT_PASSWORD=
# Websocket path override (only used when MQTT_TRANSPORT=websockets)
MQTT_WS_PATH=/
# Keep true behind production HTTPS. Local Compose explicitly uses false for HTTP.
COOKIE_SECURE=true
# Optional first-use key. If blank, a random key is printed in the backend log.
DASHBOARD_SETUP_TOKEN=

# Battery alerts. Keep secrets in .env or your deployment secret store.
# See ALERTS.md. Telegram is primary; SMTP email is the fallback.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
# starttls (587) or ssl (465); plaintext SMTP is not supported.
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
